APP_ENV=dev
LOG_LEVEL=INFO
INFERENCE_EXECUTION_MODE=queued

# Local authentication. Keep AUTH_DISABLED=false outside explicit dev/test compatibility runs.
AUTH_DISABLED=false
JWT_SECRET=
JWT_ISSUER=rag-based-ai-assistant
JWT_AUDIENCE=rag-api
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
API_KEY_DEFAULT_TTL_SEC=7776000
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SEC=60

API_HOST=0.0.0.0
API_PORT=8000

# Local artifacts directory.
ARTIFACTS_DIR=artifacts/artifacts_rag_baseline_latest
FORCE_ARTIFACTS_DOWNLOAD=false

# S3-storage with retriever artifacts.
S3_ENDPOINT_URL=https://s3.eu-west-4.idrivee2.com
S3_BUCKET=rag-assistant-storage
S3_ARTIFACT_KEY=rag-baseline/artifacts_rag_baseline_latest.zip
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-4

# Self-hosted OpenAI-compatible model API.
# This Docker-oriented URL reaches a model server running natively on the host.
MODEL_API_BASE_URL=http://host.docker.internal:11434/v1
GENERATION_MODEL=qwen2.5-coder:7b
MODEL_API_TOKEN=
MODEL_REQUEST_TIMEOUT=90
MODEL_RETRIES=3
MODEL_RETRY_BACKOFF_SEC=3.0
MODEL_TEMPERATURE=0.2
MODEL_MAX_CONTEXT_CHARS=12000
MODEL_READINESS_TIMEOUT=2
MODEL_READINESS_PATH=/models

# Local application state (never use the future Neon JDBC demo for this database).
POSTGRES_APP_DB=rag
POSTGRES_APP_USER=rag
POSTGRES_APP_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://rag:change-me-for-local-development@postgres:5432/rag

# Redis Streams delivery and worker coordination.
REDIS_URL=redis://redis:6379/0
INFERENCE_JOBS_STREAM=rag:inference:jobs
INFERENCE_CONSUMER_GROUP=rag-inference-workers
INFERENCE_EVENTS_PREFIX=rag:inference:events
INFERENCE_DLQ_STREAM=rag:inference:dlq
INFERENCE_HEARTBEAT_PREFIX=rag:inference:heartbeat
INFERENCE_EVENT_MAXLEN=1000
INFERENCE_EVENT_TTL_SEC=86400
WORKER_HEARTBEAT_TTL_SEC=20
WORKER_STALE_AFTER_SEC=30
WORKER_ID=worker-1
WORKER_LEASE_SEC=300
INFERENCE_WAIT_TIMEOUT_SEC=120
INFERENCE_MAX_ATTEMPTS=3
INFERENCE_RETRY_BACKOFF_SEC=1

# Safe artifact limits.
ARTIFACTS_MAX_ARCHIVE_BYTES=2147483648
ARTIFACTS_MAX_EXTRACTED_BYTES=4294967296

# General RAG settings.
DEFAULT_MODE=rag
TOP_K=5
DOC_TOP_K=5
CODE_TOP_K=3
MAX_NEW_TOKENS=1000
DOC_MAX_NEW_TOKENS=1500
CODE_MAX_NEW_TOKENS=2000

# SQL generation settings.
SQL_TOP_K=10
SQL_SCHEMA_SOURCE=database_schema
SQL_DIALECT=postgres
SQL_MAX_REPAIR_ATTEMPTS=1
SQL_MAX_NEW_TOKENS=900
SQL_TEMPERATURE=0.0
SQL_ENABLE_EXPLAIN_VALIDATION=true
SQL_EXPLAIN_TIMEOUT_SEC=10

# Optional Postgres connection for SQL EXPLAIN validation.
# Required only when SQL_ENABLE_EXPLAIN_VALIDATION=true.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Telegram bot settings.
TELEGRAM_BOT_TOKEN=
API_KEY=

# For local development:
API_BASE_URL=http://127.0.0.1:8000

# For Docker Compose, use:
# API_BASE_URL=http://api:8000

REQUEST_TIMEOUT=90

# The current Telegram bot uses the stable non-streaming /ask endpoint.
STREAM_EDIT_INTERVAL_SEC=1.0
STREAM_MIN_CHARS_DELTA=40
USE_MESSAGE_DRAFTS=false
