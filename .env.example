APP_ENV=dev
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

ARTIFACTS_DIR=artifacts/artifacts_rag_baseline_latest
FORCE_ARTIFACTS_DOWNLOAD=false

S3_ENDPOINT_URL=
S3_BUCKET=
S3_ARTIFACT_KEY=rag-baseline/artifacts_rag_baseline_latest.zip
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_CONTEXT_CHARS=12000

STREAM_EDIT_INTERVAL_SEC=1.0
STREAM_MIN_CHARS_DELTA=40

TOP_K=5
MAX_NEW_TOKENS=220
DEFAULT_MODE=rag

TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://api:8000
# для локального запуска
# API_BASE_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT=60