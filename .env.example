# Safe local-development template. Never commit the copied .env file.
APP_ENV=dev
TRUSTED_PROXY_CIDRS=127.0.0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_DISABLED=false
JWT_SECRET=local-only-replace-with-32-plus-random-characters
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:8080

POSTGRES_APP_DB=rag
POSTGRES_APP_USER=rag
POSTGRES_APP_PASSWORD=local-only-change-this-password
REDIS_PASSWORD=local-only-change-this-password
DATABASE_URL=postgresql+psycopg://rag:local-only-change-this-password@postgres:5432/rag
REDIS_URL=redis://:local-only-change-this-password@redis:6379/0

# Native Ollama/llama.cpp on macOS; Compose reaches it through host.docker.internal.
MODEL_API_BASE_URL=http://host.docker.internal:11434/v1
GENERATION_MODEL=qwen2.5-coder:7b
MODEL_API_TOKEN=
MODEL_REQUEST_TIMEOUT=90
MODEL_RETRIES=3
MODEL_RETRY_BACKOFF_SEC=3
MODEL_TEMPERATURE=0.15

# Default Compose runs the CPU embedding service. Use compose.native-models.yml for native MPS.
EMBEDDING_API_BASE_URL=http://embedding-service:8001/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_VERSION=bge-m3/1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_WARMUP=true
EMBEDDING_HEALTH_START_PERIOD=30m
EMBEDDING_API_TOKEN=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=1
RERANKER_API_BASE_URL=
RERANKER_API_TOKEN=

INFERENCE_MAX_ATTEMPTS=3
WORKER_LEASE_SEC=300
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SEC=300
INDEXING_MAX_ATTEMPTS=3
INDEXING_LEASE_SEC=300
SQL_ENABLE_EXPLAIN_VALIDATION=true
SQL_EXPLAIN_TIMEOUT_SEC=10

WEB_PORT=8080
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_KEY=
API_BASE_URL=http://api:8000

# Optional read-only model artifact cache. Values are credential references only.
MODEL_ARTIFACT_STORE_ENABLED=false
MODEL_ARTIFACT_S3_ENDPOINT_REF=
MODEL_ARTIFACT_S3_CREDENTIAL_REF=
