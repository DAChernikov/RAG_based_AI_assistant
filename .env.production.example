# Production values are placeholders. Store actual secrets in Docker/Kubernetes secret facilities.
APP_ENV=production
# Immutable release images; replace every digest from the signed release manifest.
API_IMAGE=ghcr.io/OWNER/rag-assistant@sha256:REPLACE_WITH_RELEASE_DIGEST
WORKER_IMAGE=ghcr.io/OWNER/rag-assistant@sha256:REPLACE_WITH_RELEASE_DIGEST
INGESTION_IMAGE=ghcr.io/OWNER/rag-assistant-ingestion@sha256:REPLACE_WITH_RELEASE_DIGEST
EMBEDDING_IMAGE=ghcr.io/OWNER/rag-assistant-embedding@sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_IMAGE=ghcr.io/OWNER/rag-assistant-web@sha256:REPLACE_WITH_RELEASE_DIGEST
BOT_IMAGE=ghcr.io/OWNER/rag-assistant-bot@sha256:REPLACE_WITH_RELEASE_DIGEST
TRUSTED_PROXY_CIDRS=10.0.0.0/8
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.invalid/v1/traces
AUTH_DISABLED=false
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=https://assistant.example.invalid
POSTGRES_APP_DB=rag
POSTGRES_APP_USER=rag_app
POSTGRES_APP_PASSWORD=REPLACE_VIA_SECRET_STORE
REDIS_PASSWORD=REPLACE_VIA_SECRET_STORE
DATABASE_URL=postgresql+psycopg://rag_app:REPLACE_VIA_SECRET_STORE@postgres.example.invalid:5432/rag?sslmode=verify-full
REDIS_URL=rediss://:REPLACE_VIA_SECRET_STORE@redis.example.invalid:6380/0
MODEL_API_BASE_URL=https://generation.internal.example.invalid/v1
GENERATION_MODEL=qwen2.5-coder-7b-instruct
MODEL_API_TOKEN=REPLACE_VIA_SECRET_STORE_OR_LEAVE_EMPTY_FOR_TRUSTED_NETWORK
MODEL_HTTP_ALLOWED_HOSTS=
EMBEDDING_API_BASE_URL=https://embeddings.internal.example.invalid/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_VERSION=bge-m3/1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_TOKEN=REPLACE_VIA_SECRET_STORE_OR_LEAVE_EMPTY_FOR_MTLS
RERANKER_API_BASE_URL=
RERANKER_API_TOKEN=
MODEL_REQUEST_TIMEOUT=90
EMBEDDING_REQUEST_TIMEOUT=60
INFERENCE_API_CONCURRENCY=32
MAX_REQUEST_BODY_BYTES=1048576
SSE_MAX_LIFETIME_SEC=900
SQL_ENABLE_EXPLAIN_VALIDATION=true
TELEGRAM_BOT_TOKEN=REPLACE_VIA_SECRET_STORE_IF_ENABLED
TELEGRAM_API_KEY=REPLACE_VIA_SECRET_STORE_IF_ENABLED
